# Local Environment Variables (Copy to .env.local)

# Shopify Integration (optional)
# NEXT_PUBLIC_SHOPIFY_DOMAIN=yourstore.myshopify.com
# NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_token_here

# WooCommerce Integration (optional)
# NEXT_PUBLIC_WC_URL=https://yourstore.com
# NEXT_PUBLIC_WC_CONSUMER_KEY=ck_xxxxx
# NEXT_PUBLIC_WC_CONSUMER_SECRET=cs_xxxxx

# API Configuration (optional)
# NEXT_PUBLIC_API_URL=https://api.yourstore.com
# NEXT_PUBLIC_API_KEY=your_api_key

# Analytics (optional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# CDN for 3D Models (optional)
# NEXT_PUBLIC_MODELS_CDN=https://cdn.yourstore.com/models

# Development
# NEXT_PUBLIC_ENV=development
